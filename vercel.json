{
  "buildCommand": "npm run build:site --workspace @prism3/studio",
  "outputDirectory": "apps/studio/public",
  "ignoreCommand": "bash apps/studio/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "lane/*": false,
      "fold/*": false,
      "docs/*": false,
      "archive/*": false,
      "claude/*": false,
      "design/*": false,
      "fix/*": false,
      "feat/*": false,
      "net/*": false,
      "conv-*": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!docs(?:/|$)).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/docs(/.*)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
