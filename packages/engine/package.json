{
  "name": "@prism3/engine",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "The Prism3 token-generation engine — dependency-free TypeScript, run via tsx. No build step: the `exports` map below points at the .ts sources, which the surfaces bundle themselves.",
  "//": "NO build script and NO dependencies, both deliberate (#650). `exports` is CONFIGURATION, not compilation — a resolver reads this map to turn '@prism3/engine/theme' into a path, and esbuild/tsx then handle the TypeScript. Adding a build step here would mean the surfaces bundle emitted JS instead of source, which is the property that keeps the plugin's main.js free of node: builtins. The `version` field is inert: npm requires it, nothing reads it, and the only version that means anything is ENGINE_VERSION in version.ts (#1019).",
  "exports": {
    "./anatomy-figma": "./anatomy-figma.ts",
    "./anatomy-readback": "./anatomy-readback.ts",
    "./button-spacing": "./button-spacing.ts",
    "./color": "./color.ts",
    "./component-doc-sections": "./component-doc-sections.ts",
    "./component-renames": "./component-renames.ts",
    "./component-schema": "./component-schema.ts",
    "./components/button": "./components/button.ts",
    "./components/field-label": "./components/field-label.ts",
    "./components/field-message": "./components/field-message.ts",
    "./components/index": "./components/index.ts",
    "./design-md": "./design-md.ts",
    "./emit-brandinput": "./emit-brandinput.ts",
    "./emit-dtcg-overlay": "./emit-dtcg-overlay.ts",
    "./emit-figma-color": "./emit-figma-color.ts",
    "./emit-figma-font": "./emit-figma-font.ts",
    "./emit-figma-styles": "./emit-figma-styles.ts",
    "./figma-names": "./figma-names.ts",
    "./inverse-roles": "./inverse-roles.ts",
    "./levers": "./levers.ts",
    "./materialization-renames": "./materialization-renames.ts",
    "./modes": "./modes.ts",
    "./nb-fixture": "./nb-fixture.ts",
    "./persist-input": "./persist-input.ts",
    "./preview": "./preview.ts",
    "./ramp": "./ramp.ts",
    "./rename-map": "./rename-map.ts",
    "./read-back": "./read-back.ts",
    "./resolve-preview": "./resolve-preview.ts",
    "./scale": "./scale.ts",
    "./standard-design-md": "./standard-design-md.ts",
    "./style-guide-groups": "./style-guide-groups.ts",
    "./theme": "./theme.ts",
    "./tree": "./tree.ts",
    "./version": "./version.ts",
    "./vocabulary": "./vocabulary.ts",
    "./write-plan": "./write-plan.ts",
    "./schema/example-brands.json": "./schema/example-brands.json",
    "./schema/nb-measured.json": "./schema/nb-measured.json"
  }
}
