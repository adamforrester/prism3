{
  "name": "@prism3/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Prism3 design tokens as CSS custom properties: the light defaults on :root, each theme mode on [data-theme].",
  "type": "module",
  "style": "./dist/prism3.css",
  "exports": {
    ".": "./dist/prism3.css",
    "./prism3.css": "./dist/prism3.css",
    "./prism3/*.css": "./dist/prism3/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "check:consumability": "node check-consumability.mjs && node check-platforms.mjs && node check-specs.mjs",
    "check:package": "node check-package.mjs",
    "build": "node sd.ship.mjs",
    "prepack": "node sd.ship.mjs",
    "build:consumer": "node sd.consumer.mjs"
  },
  "devDependencies": {
    "@directededges/specs-schema": "0.39.0",
    "ajv": "8.20.0",
    "style-dictionary": "^5.5.0"
  }
}
