{
  "name": "@prism3/tokenpress",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Export Figma Variables, Text Styles, and Effect Styles to DTCG/W3C-compliant JSON with intelligent composite token compilation (typography, shadows, transitions)",
  "main": "dist/code.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "npx tsx test.ts",
    "test:sd": "cd tests/sd && npm run build",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@figma/plugin-typings": "^1.98.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
