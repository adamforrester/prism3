{
  "name": "@prism3/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prism3 theme studio \u2014 the DOM host that renders theming knobs (from the lever manifest) + a live component preview and per-mode contrast overlay (from previewSpec + resolvePreview). One of the two rendering hosts over the engine core (docs/08, docs/09).",
  "scripts": {
    "dev": "node build.mjs --dev",
    "build": "node build.mjs",
    "build:site": "node build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx ../../run-suites.ts",
    "test:smoke": "node test-smoke.mjs && node test-site-headers.mjs",
    "test:chrome": "node test-chrome.mjs",
    "test:chrome-shards": "node test-chrome-shards.mjs",
    "test:export-parity": "node test-export-parity.mjs",
    "test:site-headers": "node test-site-headers.mjs",
    "lint:contrast": "node lint-contrast.mjs",
    "lint:live-css": "node lint-live-css.mjs && node test-live-css.mjs",
    "check:ignore": "node vercel-ignore-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3"
  }
}
